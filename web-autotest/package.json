{
  "name": "@tencent/kuikly-web-aitest",
  "version": "0.0.1",
  "description": "Kuikly Web E2E AI automated test framework",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./config/playwright-factory": {
      "default": "./config/playwright-factory.cjs"
    }
  },
  "bin": {
    "kuikly-aitest": "./bin/kuikly-aitest.mjs"
  },
  "files": [
    "bin/",
    "config/",
    "fixtures/",
    "scripts/",
    "rules/",
    "references/",
    "index.js",
    "index.d.ts",
    "kuikly.autotest.config.cjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "release": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "setup": "node scripts/setup-fonts.mjs",
    "serve": "node scripts/serve.cjs",
    "serve:dev": "BUILD_TYPE=developmentExecutable node scripts/serve.cjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:static": "node scripts/kuikly-test.mjs --level static",
    "test:functional": "node scripts/kuikly-test.mjs --level functional",
    "test:visual": "node scripts/kuikly-test.mjs --level visual",
    "test:hybrid": "node scripts/kuikly-test.mjs --level hybrid",
    "test:modules": "playwright test tests/functional/modules",
    "test:update-snapshots": "playwright test --update-snapshots",
    "test:smoke": "playwright test tests/static/smoke-static.spec.ts",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:8080",
    "install:browsers": "playwright install",
    "coverage": "node scripts/coverage-report.mjs",
    "coverage:check": "node scripts/coverage-report.mjs --check",
    "kuikly-test": "node scripts/kuikly-test.mjs"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "keywords": [
    "playwright",
    "e2e",
    "testing",
    "kuikly"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^25.6.2",
    "monocart-coverage-reports": "^2.12.10",
    "typescript": "^5.3.0"
  }
}
